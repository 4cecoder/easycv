# ── LLM Provider ─────────────────────────────────────────────────────────────
# llama.cpp self-hosted on the gentoo VM (tailscale) — no cloud tokens
AUTOMATION_LLM_PROVIDER=llama.cpp

# ── Model ─────────────────────────────────────────────────────────────────────
# llama.cpp ignores the requested model name and serves whatever is loaded,
# but this is logged / used as a hint.
AUTOMATION_MODEL=/home/ubuntu/llama.cpp/Ornith-1.0-35B-MTP-APEX-I-Mini.gguf

# ── Endpoint ──────────────────────────────────────────────────────────────────
AUTOMATION_LLM_BASE_URL=http://gentoo.tail125a6c.ts.net:8081/v1

# ── API Key ───────────────────────────────────────────────────────────────────
AUTOMATION_API_KEY=

# ── TDD Controls ──────────────────────────────────────────────────────────────
AUTOMATION_TDD_MAX_ROUNDS=5
AUTOMATION_TDD_MAX_FAILURES=10

# ── Playwright ────────────────────────────────────────────────────────────────
AUTOMATION_PLAYWRIGHT_URL=http://localhost:3000

# ── Debug ─────────────────────────────────────────────────────────────────────
AUTOMATION_VERBOSE=1