# =============================================================================
# easyCV Production Environment Variables
# =============================================================================
#
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to version control.
#
# The deploy.sh script reads this file, base64-encodes each value,
# and applies it as a Kubernetes Secret.
#
# =============================================================================

# ── Self-Hosted Convex Configuration ────────────────────────────────────────
# Instance name and 32-byte secret (generate secret: openssl rand -hex 32)
INSTANCE_NAME=easycv-prod
INSTANCE_SECRET=generate_with_openssl_rand_hex_32

# Production Database (SQLite vs Vultr Managed Postgres):
# - Default (empty): Uses SQLite with PersistentVolume (k8s/convex-storage.yaml)
# - Production: Add Vultr Managed Postgres connection string:
#   POSTGRES_URL=postgres://user:password@vultr-postgres-host:5432/easycv?sslmode=require
POSTGRES_URL=

# Public and internal Convex URLs:
NEXT_PUBLIC_CONVEX_URL=https://convex.yourdomain.com/api
CONVEX_URL=http://convex-backend:3210
CONVEX_SITE_URL=http://convex-backend:3211

# ── Application ─────────────────────────────────────────────────────────────
# Public URL where the app is accessible
APP_URL=https://easycv.yourdomain.com

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_standard_price_id
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# ── Worker Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Set inside Convex via: bunx convex env set WORKER_SECRET <value>
WORKER_SECRET=generate_with_openssl_rand_hex_32

# ── LLM Configuration ──────────────────────────────────────────────────────
# Provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=openbmb/minicpm5:latest

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_API_BASE=http://your-ollama-host:11434

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
