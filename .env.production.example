# =============================================================================
# easyCV Production Environment Variables
# =============================================================================
#
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to version control.
#
# The deploy.sh script reads this file, base64-encodes each value,
# and applies it as a Kubernetes Secret.
#
# =============================================================================
# MINIMUM REQUIRED (or set as GitHub Actions secrets):
#   VCR_USERNAME, VCR_PASSWORD, VCR_PROJECT  — Vultr Container Registry
#   DOMAIN, EMAIL                            — Your domain + Let's Encrypt email
#   KUBECONFIG                               — Your cluster kubeconfig
#   STRIPE_SECRET_KEY                        — Stripe live secret key
#   OPENAI_API_KEY                           — OpenAI API key (if using OpenAI)
#
# Everything below has sensible defaults — only override if needed.
# =============================================================================

# ── Vultr Container Registry ────────────────────────────────────────────────
# VCR_REGISTRY is already hardcoded to registry.vultrcr.com
# VCR_PROJECT, VCR_USERNAME, VCR_PASSWORD — set as GitHub secrets

# ── Domain & TLS ────────────────────────────────────────────────────────────
# DOMAIN=easycv.example.com
# EMAIL=you@email.com

# ── Convex Database (default: self-hosted) ──────────────────────────────────
# CONVEX_MODE=self-hosted
# CONVEX_DEPLOY_KEY=          # Only needed if CONVEX_MODE=cloud
# POSTGRES_URL=               # Optional: Vultr Managed Postgres connection string

# ── URLs (auto-derived from DOMAIN if not set) ──────────────────────────────
# APP_URL=https://${DOMAIN}
# NEXT_PUBLIC_CONVEX_URL=https://convex.${DOMAIN}/api
# CONVEX_URL=http://convex-backend:3210
# CONVEX_SITE_URL=http://convex-backend:3211

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_PRICE_ID=price_your_standard_price_id
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# ── Worker Auth (auto-generated if not set) ─────────────────────────────────
# WORKER_SECRET=             # Auto-generated with openssl rand -hex 32

# ── LLM (defaults to openai/gpt-4o) ────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-api-key
# ANTHROPIC_API_KEY=         # Only needed if LLM_PROVIDER=anthropic
# OLLAMA_API_BASE=           # Only needed if LLM_PROVIDER=ollama

# ── Analytics (optional) ────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
