# Local runs (do not commit backend.hcl — it is gitignored).
# Credentials: export AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# (or VULTR_S3_ACCESS_KEY / VULTR_S3_SECRET_KEY via configure-s3-backend.sh).
#
# region is a dummy AWS region — Vultr Object Storage ignores it.

bucket                      = "easycvtfstate"
key                         = "vke/terraform.tfstate"
region                      = "us-east-1"
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
endpoints = {
  s3 = "https://atl2.vultrobjects.com"
}
