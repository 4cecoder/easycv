# =============================================================================
# .env.compose.example — Environment variables for docker-compose.yml
# =============================================================================
#
# Copy this file to .env.compose (or rely on web/.env.local which both
# services mount via env_file). This file exists to document every variable
# the Docker Compose stack needs.
#
# docker-compose.yml mounts web/.env.local as the env_file for both services.
# The values below are documented here for reference — copy them into
# web/.env.local (which already exists and is gitignored).
#
# =============================================================================

# ── Convex (cloud SaaS — both services need this) ──────────────────────────
# Deployment URL printed by `npx convex dev` / `npx convex deploy`.
# NEXT_PUBLIC_ prefix is required because Next.js bakes it into the client
# bundle at build time, and the worker reads it too.
NEXT_PUBLIC_CONVEX_URL=

# ── Next.js App ────────────────────────────────────────────────────────────
# Trusted base URL for Stripe Checkout success/cancel redirects.
# Use http://localhost:3000 for local Docker dev.
APP_URL=http://localhost:3000

# ── Stripe (both services — frontend for checkout, worker reads indirectly) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Optional: "payment" (one-time) or "subscription" (recurring)
STRIPE_CHECKOUT_MODE=

# ── LLM (worker — the actual processing daemon) ────────────────────────────
# Provider: "openai" (default), "anthropic", or "ollama" (local/self-hosted)
LLM_PROVIDER=openai
# Model override — leave blank for provider default (gpt-4o for OpenAI).
# Examples: "gpt-4o", "claude-sonnet-4-20250514", "llama3.2"
LLM_MODEL=
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Ollama-specific — where Ollama is reachable from inside the container.
# Docker Desktop (macOS/Windows): use host.docker.internal
# Linux with --network=host: use http://localhost:11434
# Remote Ollama: use its Tailscale/LAN address
OLLAMA_API_BASE=http://host.docker.internal:11434
# Optional: timeout in seconds for Ollama API calls (default: 300)
OLLAMA_TIMEOUT=

# ── Worker auth ─────────────────────────────────────────────────────────────
# Shared secret between Convex deployment and worker.
# Set via: npx convex env set WORKER_SECRET <random-hex>
# Must match on both sides. Regenerate with: openssl rand -hex 32
WORKER_SECRET=

# ── Analytics (frontend — optional) ────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
