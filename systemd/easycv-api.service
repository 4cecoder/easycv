[Unit]
Description=easyCV Backend API Server
After=network.target tailscaled.service

[Service]
Type=simple
User=fource
WorkingDirectory=/home/fource/bytecats/projects/web/easycv
Environment="PATH=/home/fource/.local/bin:/usr/bin:/bin"
ExecStart=/home/fource/.local/bin/uv run python -m backend.api_server --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easycv-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/fource/bytecats/projects/web/easycv
ReadWritePaths=/tmp

# Resource limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target