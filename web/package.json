{
  "name": "easycv-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web/Convex backend for easyCV (root for eventual Next.js frontend).",
  "type": "module",
  "scripts": {
    "postinstall": "cd .. && ./automation/install-hooks.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:ci": "bun run test:unit",
    "evaluate": "bun run scripts/evaluate-edge-pipeline.ts",
    "dev:convex": "convex dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bytecats/ui-kit": "github:4cecoder/ui-kit",
    "@convex-dev/stripe": "^0.1.6",
    "@huggingface/transformers": "^4.2.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "posthog-js": "^1.408.3",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.20.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.54",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.20",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
