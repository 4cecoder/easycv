# Copy this to .env.local for local dev (never commit real values -- see
# .gitignore). All of these are consumed by the Next.js app under app/api/**.

# Convex deployment URL (same one `npx convex dev`/`npx convex deploy` prints).
# Prefixed NEXT_PUBLIC_ because it's also safe/needed on the client.
NEXT_PUBLIC_CONVEX_URL=

# Trusted base URL for this app (e.g. https://easycv.example.com, or
# http://localhost:3000 for local dev). Used to build Stripe Checkout's
# success_url/cancel_url -- deliberately NOT derived from the request's
# Origin header, which is attacker-controlled.
APP_URL=

# Stripe (one-time Checkout, per rf-2 -- never subscription mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Price object Checkout charges. Controls the $9-19 rf-2 cites --
# tune the amount in the Stripe dashboard, not in code.
STRIPE_PRICE_ID=

# Which LLM backs `pipeline.py consolidate-stdin`. Defaults to "ollama" if
# unset -- runs entirely locally, no API key needed. Set to "openai" or
# "anthropic" for higher-quality hosted extraction (needs the matching
# <PROVIDER>_API_KEY below, pipeline.py's own convention, pipeline.py:393).
LLM_PROVIDER=
# Optional model override, e.g. "openbmb/minicpm5:latest" for a locally
# pulled Ollama model that isn't pipeline.py's llama3.2 default, or
# "gpt-4o"/"claude-sonnet-4-..." for a hosted provider.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
