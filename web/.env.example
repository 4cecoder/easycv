# Copy this to .env.local for local dev (never commit real values -- see
# .gitignore). All of these are consumed by the Next.js app under app/api/**.

# Convex deployment URL (same one `npx convex dev`/`npx convex deploy` prints).
# Prefixed NEXT_PUBLIC_ because it's also safe/needed on the client.
NEXT_PUBLIC_CONVEX_URL=

# Seridian Auth OIDC relying-party client (register redirect URI:
# <APP_URL>/api/auth/callback). Use the same exact issuer and client id on the
# Convex deployment as SERIDIAN_AUTH_ISSUER and SERIDIAN_AUTH_CLIENT_ID.
# Exact `issuer` value returned by the Seridian Auth discovery document.
# Production currently returns https://successful-puma-904.convex.site. The
# permanent https://auth.seridian.dev issuer switch is a coordinated migration
# (core ADR 0002); do not assume it has happened until discovery confirms.
SERIDIAN_AUTH_ISSUER=
SERIDIAN_AUTH_CLIENT_ID=
SERIDIAN_AUTH_CLIENT_SECRET=

# Admin allowlist (comma-separated verified Seridian emails). Set the same
# value in the web deployment and Convex deployment environment.
ADMIN_EMAILS=

# Trusted base URL for this app (production: https://easycv.seridian.dev, or
# http://localhost:3000 for local dev). Used to build Stripe Checkout's
# success_url/cancel_url -- deliberately NOT derived from the request's
# Origin header, which is attacker-controlled.
APP_URL=

# Stripe (supports one-time payment or subscription mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for single download payment ($9-19)
STRIPE_PRICE_ID=
# Price ID for subscription ($14/mo Pro membership)
STRIPE_PRO_PRICE_ID=
# Optional default checkout mode ("payment" | "subscription")
STRIPE_CHECKOUT_MODE=

# Hosted LLM used by the web serverless job-match route and worker.
# Production must use a hosted provider (openai or anthropic), never local Ollama.
LLM_PROVIDER=
# Model override. Examples: "gpt-4o", "claude-sonnet-4-20250514"
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
