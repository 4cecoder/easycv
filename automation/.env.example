# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: llama.cpp (default, gentoo box powerful model) | ollama | qwen
AUTOMATION_LLM_PROVIDER=llama.cpp

# ── Model ─────────────────────────────────────────────────────────────────────
# The powerful model on gentoo's llama.cpp endpoint:
AUTOMATION_MODEL=ornith-35b-q4k
# Or for Qwen (Alibaba DashScope):
# AUTOMATION_MODEL=qwen2.5-coder-14b-instruct

# ── Endpoint ──────────────────────────────────────────────────────────────────
# Defaults to http://gentoo.tail125a6c.ts.net:8081/v1 for llama.cpp (powerful)
# or https://dashscope-intl.aliyuncs.com/compatible-mode/v1 for Qwen
# AUTOMATION_LLM_BASE_URL=http://gentoo.tail125a6c.ts.net:8081/v1

# ── API Key (for Qwen or OpenAI) ──────────────────────────────────────────────
# llama.cpp on gentoo doesn't need this. Qwen needs your DashScope API key:
# AUTOMATION_API_KEY=sk-...

# ── TDD Controls ──────────────────────────────────────────────────────────────
AUTOMATION_TDD_MAX_ROUNDS=5
AUTOMATION_TDD_MAX_FAILURES=10

# ── Playwright ────────────────────────────────────────────────────────────────
AUTOMATION_PLAYWRIGHT_URL=http://localhost:3000

# ── Debug ─────────────────────────────────────────────────────────────────────
AUTOMATION_VERBOSE=0
