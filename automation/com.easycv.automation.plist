<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.easycv.automation</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fource/bytecats/easycv/automation/schedule.sh</string>
        <string>--limit</string>
        <string>3</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/fource/bytecats/easycv</string>

    <!-- Run at 03:00 daily -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/fource/bytecats/easycv/automation/logs/launchd-out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fource/bytecats/easycv/automation/logs/launchd-err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
